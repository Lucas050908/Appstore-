<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">#F3D867</item>
    </style>
    <style name="AlarmTheme" parent="AppTheme">
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
    <color name="bg">#12110F</color>
    <color name="ic_bg">#3E6FD8</color>

    <style name="WBtn">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/wbtn_dark</item>
        <item name="android:textColor">#F3D867</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WCity">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="WCityName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/caveat</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">#5A5446</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="WCityTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:format24Hour">HH:mm</item>
        <item name="android:format12Hour">h:mm</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#1D1B17</item>
    </style>
</resources>
