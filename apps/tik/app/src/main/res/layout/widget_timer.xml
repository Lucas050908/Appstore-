<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/wbg_orange" android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="12dp">
    <LinearLayout android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timer"
            android:fontFamily="@font/caveat" android:textSize="24sp" android:textColor="#1D1B17" android:includeFontPadding="false"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11.5sp" android:textColor="#5A5446" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/b1" style="@style/WBtn"/>
    <TextView android:id="@+id/b2" style="@style/WBtn"/>
    <TextView android:id="@+id/b3" style="@style/WBtn"/>
    <TextView android:id="@+id/b4" style="@style/WBtn"/>
</LinearLayout>
