[
["expect", "frisk installation viser ikke nyt-ark", "!document.querySelector('#sheet').classList.contains('on') && localStorage.getItem('tik.ver') === '\"1.1.0\"'"],
["expect", "tema følger systemet (lyst i testen)", "document.documentElement.dataset.theme === 'light'"],
["expect", "hurtig alarm-knapper", "document.querySelectorAll('[data-quick]').length === 6"],
["click", "[data-quick='30']"],
["expect", "hurtig alarm oprettet 30 min frem", "(() => { const a = S.alarms[0], t = nextFire(a), d = (t - Date.now()) / 60000; return S.alarms.length === 1 && a.quick && a.enabled && d > 29 && d <= 31 || [S.alarms, d]; })()"],
["shot", "hurtig"],
["eval", "(() => { const a = { ...S.alarms[0], enabled: false }; call('saveAlarm', JSON.stringify(a)); })()"],
["click", "[data-quick='60']"],
["expect", "gammel hurtig alarm ryddes", "S.alarms.length === 1 && S.alarms[0].enabled"],
["eval", "(() => { const t = new Date(Date.now() + 9 * 36e5); call('saveAlarm', JSON.stringify({ id: 'x1', h: t.getHours(), m: t.getMinutes(), days: [], label: 'Arbejde', enabled: true, vibrate: true, gradual: true, snooze: 9, sound: '', soundTitle: 'Standard alarmlyd', color: 'yellow' })); call('deleteAlarm', S.alarms.find(a => a.quick).id); })()"],
["expect", "sengetid-knap ved alarm langt ude", "!!document.querySelector('#bedBtn')"],
["expect", "sengetider: 6, 5 og 4 cyklusser", "(() => { const w = Date.UTC(2026, 0, 2, 6, 0), b = bedTimes(w); return b.length === 3 && w - b[0].at === (9 * 60 + 15) * 60000 && w - b[1].at === (7.5 * 60 + 15) * 60000 && w - b[2].at === (6 * 60 + 15) * 60000; })()"],
["click", "#bedBtn"],
["expect", "sengetid-ark med tre forslag", "document.querySelectorAll('#sheet .beds .sticky').length === 3"],
["shot", "sengetid"],
["click", "#bedOk"],
["click", "[data-tab=world]"],
["expect", "skyder til tidsrejse", "!!document.querySelector('#shR') && document.querySelector('#shL').textContent === 'Lige nu'"],
["eval", "(() => { const r = document.querySelector('#shR'); r.value = 600; r.dispatchEvent(new Event('input')); })()"],
["expect", "byerne flytter sig 10 timer", "(() => { const d = new Date(Date.now() + 600 * 60000), p = tzParts(cityTz(S.cities[0]), d), t = document.querySelector('.city .t').textContent; return worldShift === 600 && t === pad(p.h) + ':' + pad(p.m) && / hos dig$/.test(document.querySelector('#shL').textContent) || [t, p]; })()"],
["eval", "document.querySelector('#shR').dispatchEvent(new Event('change'))"],
["shot", "tidsrejse"],
["click", "#shNow"],
["expect", "nu-knap nulstiller", "worldShift === 0 && document.querySelector('#shL').textContent === 'Lige nu' && !!document.querySelector('#locT small')"],
["click", "[data-tab=stopwatch]"],
["click", "#swA"], ["wait", 300], ["click", "#swB"], ["wait", 250], ["click", "#swB"], ["click", "#swA"],
["expect", "stopur viser snit og kopiér", "/2 omgange · snit 00:00,/.test(document.querySelector('.sw-tools span').textContent) && !!document.querySelector('#swCopy')"],
["expect", "omgangstekst", "(() => { const t = swText().split('\\n'); return t.length === 3 && /^Stopur /.test(t[0]) && /^Omgang 1\\t00:00,\\d\\d\\t00:00,\\d\\d$/.test(t[1]) || t; })()"],
["click", "#swCopy"],
["shot", "stopur"],
["click", "#btnSettings"],
["expect", "indstillinger: system valgt, nyt-række", "document.querySelector('#setTheme .on').dataset.k === 'system' && !!document.querySelector('#setNews')"],
["expect", "trykflader i indstillinger ≥ 40 px", "[...document.querySelectorAll('#sheet .val')].every(b => b.getBoundingClientRect().height >= 40) || [...document.querySelectorAll('#sheet .val')].map(b => b.getBoundingClientRect().height)"],
["click", "#setNews"],
["expect", "nyt-ark kan åbnes", "document.querySelectorAll('.newslist li').length === 5"],
["shot", "nyt"],
["click", "#newsOk"],
["eval", "localStorage.setItem('tik.ver', '\"1.0.0\"')"],
["reload"],
["expect", "nyt-ark vises efter opdatering", "document.querySelector('#sheet').classList.contains('on') && !!document.querySelector('#newsOk')"],
["click", "#newsOk"],
["reload"],
["expect", "… og kun én gang", "!document.querySelector('#sheet').classList.contains('on')"],
["expect", "ingen vandret overløb", "document.documentElement.scrollWidth <= innerWidth + 1"]
]
